# Shared
NODE_ENV=development

# API
# Hosted platforms usually provide PORT automatically. API_PORT is used locally.
API_PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=mysql://username:password@localhost:3306/memoria
SESSION_SECRET=replace-with-a-long-random-string
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
